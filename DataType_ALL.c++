#include <iostream>
using namespace std;
int main(){


    //integer data type 
    int a =10;
    cout<<a<<endl;
    cout<<"size of int: "<<sizeof(a)<<"\n";


    // float data type
    float b=3.14;
    cout << b <<endl;
    cout<<"size of float: "<<sizeof (b)<<endl;


    // double data type
    double c=3.142334456;
    cout << c <<endl;
    cout<<"size of double: "<<sizeof (c)<<endl;


    // character data type
    char d='A';
    cout << d <<endl;
    cout<<"size of char: "<<sizeof (d)<<endl;   
    
    
    // boolean data type
    bool e=true;
    cout << e <<endl;
    cout<<"size of bool: "<<sizeof (e)<<endl;


    return 0;
}